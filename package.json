{
  "name": "personal-organizer",
  "productName": "Personal Organizer",
  "version": "1.0.0",
  "description": "Industrial-Grade Personal OS with SQLite WAL Durability & 24/7 Desktop Companion",
  "main": "electron-main.cjs",
  "author": "Personal OS Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron electron-main.cjs",
    "desktop": "electron electron-main.cjs",
    "test": "vitest run",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.personal.organizer",
    "productName": "Personal Organizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "src/app/database/**/*",
      "src/app/notifications/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.svg",
      "publisherName": "Personal OS Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Personal Organizer"
    }
  },
  "keywords": [
    "personal-os",
    "tasks",
    "reminders",
    "calendar",
    "notes",
    "sqlite-wal"
  ],
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^11.8.1",
    "electron": "^30.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
